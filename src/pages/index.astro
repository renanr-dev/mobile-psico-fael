---
import "../components/GlobalStyles.astro";
import maintenanceImage from "../images/maintanance.png";
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <title>Rafael Psicólogo</title>
    <script is:inline>
      (function () {
        const userAgent = navigator.userAgent || "";
        const isPhoneUserAgent = /Android|iPhone|iPod|Windows Phone|Mobile|Opera Mini/i.test(userAgent);
        const isTouchDevice = window.matchMedia("(pointer: coarse)").matches || "ontouchstart" in window || navigator.maxTouchPoints > 0;
        const isSmallScreen = window.matchMedia("(max-width: 768px)").matches;
        const isPhone = isPhoneUserAgent && isTouchDevice && isSmallScreen;
        const shouldRedirect = !isPhone;
        const mainSiteUrl = "https://psicologorafaelpinho.com.br/";
        const isAlreadyMainSite = window.location.origin === new URL(mainSiteUrl).origin;

        if (shouldRedirect && !isAlreadyMainSite) {
          window.location.replace(mainSiteUrl);
        }
      })();
    </script>
  </head>
  <body>
    <main class="maintenance">
      <section class="maintenance__content" aria-label="Mensagem de manutenção">
        <img
          class="maintenance__image"
          src={maintenanceImage.src}
          alt="Imagem de manutenção"
        />
        <p>
          Olá! Que bom te ver aqui. No momento, este site está passando por um processo de melhoria.
          Se está procurando o Rafael, busque @psi.rafaelpinho no Instagram, ou clique no botão abaixo.
          Até breve!
        </p>
        <a href="https://www.instagram.com/psi.rafaelpinho/" target="_blank" rel="noreferrer">
          <i class="fa fa-instagram" aria-hidden="true"></i>
          Ir para o Instagram
        </a>
      </section>
    </main>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
    height: 100%;
    overflow-x: hidden;
    background: #ffffff;
    color: #292828;
    font-family: "calibri-regular", sans-serif;
  }

  :global(body) {
    min-height: 100dvh;
  }

  @font-face {
    font-family: "calibri-regular";
    src: url("/fonts/calibri-regular.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .maintenance {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(24px, 6vw, 32px);
    box-sizing: border-box;
    background: #4cc782;
  }

  .maintenance__content {
    width: min(100%, 420px);
    min-height: min(80dvh, 620px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 4vw, 24px);
  }

  .maintenance__image {
    width: min(100%, 330px);
    max-width: 240px;
    height: auto;
    display: block;
    border-radius: 16px;
  }

  .maintenance__content p {
    margin: 0;
    font-size: clamp(1.35rem, 5.2vw, 1.75rem);
    line-height: 1.55;
    color: #ffffff;
    max-width: 100%;
    text-align: justify;
  }

  .maintenance__content a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    max-width: 280px;
    padding: 12px 18px;
    border-radius: 999px;
    background: #a17ece;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: clamp(1rem, 4vw, 1.1rem);
    transition: transform 0.2s ease, opacity 0.2s ease;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .maintenance__content a:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  .maintenance__content a i {
    font-size: 1.2rem;
  }

  @media (max-width: 480px) {
    .maintenance {
      padding: 36px;
    }

    .maintenance__content {
      width: 100%;
      min-height: auto;
      gap: 24px;
    }

    .maintenance__image {
      max-width: 330px;
    }

    .maintenance__content p {
      font-size: 1.28rem;
      line-height: 1.6;
    }

    .maintenance__content a {
      max-width: 100%;
      padding: 12px 16px;
    }
  }
</style>
